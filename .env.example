# ---------------------------------------------------------------
# TypeSense environment variables
# Copy this file to `.env.local` and fill in the values.
# All values are safe to expose to the browser EXCEPT the service
# role key, which must NEVER be used in frontend code.
# ---------------------------------------------------------------

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=

# Supabase anon/public key (Project Settings -> API)
# RLS protects user data; the anon key is designed for browsers.
VITE_SUPABASE_ANON_KEY=

# Optional: enable Google OAuth (requires provider configured in
# Supabase Dashboard -> Authentication -> Providers)
VITE_ENABLE_GOOGLE_AUTH=false
